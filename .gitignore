public/search-index.*.json
*:Zone.Identifier

# secrets
.env
.env.local
.env.*.local
.vercel
.env*.local

*.DS_Store

# source product photos (large originals, not bundled)
Hình mặt trước sau bộ điều khiển/
Gói sản phẩm/
images-origin/

# source product PDFs (large originals, not bundled)
*.pdf
# the download library ships with the site, so those PDFs stay tracked
!public/downloads/**/*.pdf

# crawl scratch data (not bundled)
download/
dims-tmp.json
.claude/

# image i18n backups (working artifacts, not bundled)
.backup-zh-detail-images/
.image-i18n-work/

# python caches from tooling scripts
__pycache__/
*.pyc

# playwright test artifacts
/test-results/

# generated responsive image variants (regenerated by prebuild)
public/**/*-[0-9]*w.webp
