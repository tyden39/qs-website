
NEXT_PUBLIC_APP_URL=https://crm.qstcnc.com

# --- Contact / inquiry forms → CRM public lead endpoint ---
NEXT_PUBLIC_CRM_API_BASE=https://crm.qstcnc.com/api/v1

# Auth (login modal, session bootstrap, SSO ticket) also calls the CRM base
# above — no separate var, since it's the same backend.
NEXT_PUBLIC_API_LOGIN=https://crm.qstcnc.com/api/v1

# --- Account menu SSO target (AccountMenu "Portal" / "ERP" links) ---
# ERP and Portal menu items are mutually exclusive by role (see
# components/AccountMenu.tsx), so they share one SSO target.
# Left blank disables both menu items (button stays disabled).
NEXT_PUBLIC_API_SSO=https://crm.qstcnc.com
NEXT_PUBLIC_API_ERP=https://crm.qstcnc.com
NEXT_PUBLIC_API_PORTAL=https://crm.qstcnc.com
